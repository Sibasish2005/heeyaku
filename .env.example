# ==============================================================================
# HEEYAKU STARTUP TELEPHONY CRM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Connection (Supabase PostgreSQL / PgBouncer Pooler)
# DATABASE_URL: Transaction pooler port 6543 with pgbouncer=true
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"
# DIRECT_URL: Direct session connection port 5432 for Prisma migrations
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Authentication & Admin Authorization (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_placeholder_key"
CLERK_SECRET_KEY="clerk_secret_key_placeholder"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/admin/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/admin/dashboard"

# Authorized Admin Portal Emails (Comma-separated)
# Only users authenticated via Clerk with an email listed here can access /admin
ADMIN_EMAIL="admin@yourstartup.com,founder@yourstartup.com"

# Employee / BDA JWT Authentication Secret (32+ character random hex string)
EMPLOYEE_JWT_SECRET="generate_a_secure_random_64_char_hex_secret_here"

# External Lead Ingestion & Webhook API Key
# Header required: 'x-api-key: [YOUR_KEY]' or 'Authorization: Bearer [YOUR_KEY]'
EXTERNAL_INGESTION_API_KEY="crm_sync_secure_api_key_xxxxxxxx"

# Google Sheets Integration (Optional Default Sheet URL for bulk sync)
GOOGLE_SHEET_URL="https://docs.google.com/spreadsheets/d/your_sheet_id/edit#gid=0"
