generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CEO
  TEAM_LEAD
  HR
  BDA
}

enum LeadStatus {
  NEW
  ASSIGNED
  CONTACTED
  INTERESTED
  FOLLOW_UP
  CALL_BACK
  NOT_INTERESTED
  NO_ANSWER
  BUSY
  WRONG_NUMBER
  CONVERTED
  NOT_QUALIFIED
  OTHER
}

model Team {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  colorTag    String?    @default("#2563EB")
  teamLeadId  String?    @unique
  teamLead    Employee?  @relation("TeamLeadRelation", fields: [teamLeadId], references: [id], onDelete: SetNull)
  members     Employee[] @relation("TeamMembers")
  leads       Lead[]     @relation("TeamLeads")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("teams")
}

model Employee {
  id           String    @id @default(cuid())
  employeeCode String    @unique
  name         String
  email        String    @unique
  phoneNumber  String
  role         Role      @default(BDA)
  clerkUserId  String?   @unique
  team         String?   @default("General")
  teamId       String?
  teamGroup    Team?     @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  ledTeam      Team?     @relation("TeamLeadRelation")
  notes        String?
  passwordHash String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  leads        Lead[]
  callLogs     CallLog[]

  @@index([employeeCode])
  @@index([email])
  @@index([role])
  @@index([teamId])
  @@index([clerkUserId])
  @@index([isActive])
  @@map("employees")
}

model Lead {
  id                 String      @id @default(cuid())
  leadCode           String      @unique
  name               String
  phoneNumber        String
  phoneDigits        String?     // Normalized last 10 digits for exact-match dedup
  email              String?
  company            String?
  source             String      @default("MANUAL")
  status             LeadStatus  @default(NEW)
  notes              String?
  teamId             String?
  team               Team?       @relation("TeamLeads", fields: [teamId], references: [id], onDelete: SetNull)
  assignedEmployeeId String?
  assignedEmployee   Employee?   @relation(fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  assignedAt         DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  callLogs           CallLog[]

  @@index([leadCode])
  @@index([phoneNumber])
  @@index([phoneDigits])
  @@index([status])
  @@index([teamId])
  @@index([teamId, status])
  @@index([assignedEmployeeId])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([assignedEmployeeId, status])
  @@index([assignedEmployeeId, updatedAt])
  @@index([assignedAt])
  @@index([assignedEmployeeId, assignedAt])
  @@map("leads")
}

model SyncMeta {
  id            String   @id @default(cuid())
  syncType      String   @unique  // e.g. "google_sheets"
  lastRowCount  Int      @default(0)
  lastSyncedAt  DateTime @default(now())
  sheetHash     String?  // Hash of the last synced content for change detection
  updatedAt     DateTime @updatedAt

  @@map("sync_meta")
}

enum CallType {
  OUTGOING
  INCOMING
  MISSED
  REJECTED
}

model CallLog {
  id              String    @id @default(cuid())
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leadId          String?
  lead            Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  phoneNumber     String
  contactName     String?
  callType        CallType  @default(OUTGOING)
  durationSeconds Int       @default(0)
  connected       Boolean   @default(false)
  outcomeId       String?
  outcomeLabel    String?
  notes           String?
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  createdAt       DateTime  @default(now())

  @@index([employeeId])
  @@index([leadId])
  @@index([phoneNumber])
  @@index([startedAt])
  @@index([employeeId, startedAt])
  @@index([leadId, connected])
  @@index([phoneNumber, connected])
  @@map("call_logs")
}

