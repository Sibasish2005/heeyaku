generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CompanyStatus {
  PENDING_VERIFICATION
  ACTIVE
  REJECTED
  SUSPENDED_BY_ADMIN
}

enum Role {
  CEO
  TEAM_LEAD
  HR
  BDA
}


enum LeadStatus {
  NEW
  ASSIGNED
  CONTACTED
  INTERESTED
  FOLLOW_UP
  CALL_BACK
  NOT_INTERESTED
  NO_ANSWER
  BUSY
  WRONG_NUMBER
  CONVERTED
  NOT_QUALIFIED
  OTHER
}

enum CallType {
  OUTGOING
  INCOMING
  MISSED
  REJECTED
}

model Company {
  id              String        @id @default(cuid())
  name            String
  slug            String        @unique
  phoneNumber     String?
  industry        String?
  status          CompanyStatus @default(PENDING_VERIFICATION)
  maxBdas         Int           @default(5)
  requestedBdas   Int           @default(5)
  trialEndsAt     DateTime?
  verifiedAt      DateTime?
  verifiedBy      String?
  rejectionReason String?
  suspendedAt     DateTime?
  suspendReason   String?

  employees       Employee[]
  teams           Team[]
  leads           Lead[]
  callLogs        CallLog[]
  syncMeta        SyncMeta[]
  apiKeys         CompanyApiKey[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([slug])
  @@map("companies")
}

model Team {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  colorTag    String?    @default("#2563EB")
  companyId   String?
  company     Company?   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  teamLeadId  String?    @unique
  teamLead    Employee?  @relation("TeamLeadRelation", fields: [teamLeadId], references: [id], onDelete: SetNull)
  members     Employee[] @relation("TeamMembers")
  leads       Lead[]     @relation("TeamLeads")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([companyId])
  @@map("teams")
}

model Employee {
  id           String    @id @default(cuid())
  employeeCode String    @unique
  name         String
  email        String    @unique
  phoneNumber  String
  role         Role      @default(BDA)
  clerkUserId  String?   @unique
  companyId    String?
  company      Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  team         String?   @default("General")
  teamId       String?
  teamGroup    Team?     @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  ledTeam      Team?     @relation("TeamLeadRelation")
  notes        String?
  passwordHash String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  leads              Lead[]    @relation("AssignedEmployeeLeads")
  generatedProspects Lead[]    @relation("OriginalBdaProspects")
  callLogs           CallLog[]
  trustedDevices     EmployeeDevice[]

  @@index([employeeCode])
  @@index([email])
  @@index([role])
  @@index([teamId])
  @@index([clerkUserId])
  @@index([isActive])
  @@index([companyId])
  @@index([companyId, role])
  @@index([isActive, role, teamId])
  @@map("employees")
}

model Lead {
  id                 String      @id @default(cuid())
  leadCode           String      @unique
  name               String
  phoneNumber        String
  phoneDigits        String?     // Normalized last 10 digits for exact-match dedup
  email              String?
  company            String?
  source             String      @default("MANUAL")
  status             LeadStatus  @default(NEW)
  notes              String?
  companyId          String?
  companyRel         Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  teamId             String?
  team               Team?       @relation("TeamLeads", fields: [teamId], references: [id], onDelete: SetNull)
  assignedEmployeeId String?
  assignedEmployee   Employee?   @relation("AssignedEmployeeLeads", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  assignedAt         DateTime?

  // --- Prospect Promotion Tracking ---
  isProspect         Boolean     @default(false)
  promotedToProspectAt DateTime?
  originalBdaId      String?
  originalBda        Employee?   @relation("OriginalBdaProspects", fields: [originalBdaId], references: [id], onDelete: SetNull)

  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  callLogs           CallLog[]

  @@index([leadCode])
  @@index([phoneNumber])
  @@index([phoneDigits])
  @@index([status])
  @@index([isProspect])
  @@index([originalBdaId])
  @@index([companyId])
  @@index([companyId, status])
  @@index([teamId])
  @@index([teamId, status])
  @@index([teamId, assignedEmployeeId])
  @@index([teamId, updatedAt])
  @@index([assignedEmployeeId])
  @@index([assignedEmployeeId, isProspect])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([assignedEmployeeId, status])
  @@index([assignedEmployeeId, updatedAt])
  @@index([assignedAt])
  @@index([assignedEmployeeId, assignedAt])
  @@index([status, updatedAt])
  @@index([isProspect, updatedAt])
  @@index([originalBdaId, updatedAt])
  @@index([teamId, isProspect])
  @@map("leads")
}

model SyncMeta {
  id            String   @id @default(cuid())
  syncType      String   @unique  // e.g. "google_sheets"
  lastRowCount  Int      @default(0)
  lastSyncedAt  DateTime @default(now())
  sheetHash     String?  // Hash of the last synced content for change detection
  companyId     String?
  company       Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  updatedAt     DateTime @updatedAt

  @@index([companyId])
  @@map("sync_meta")
}

model CallLog {
  id              String    @id @default(cuid())
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leadId          String?
  lead            Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  companyId       String?
  company         Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  phoneNumber     String
  contactName     String?
  callType        CallType  @default(OUTGOING)
  durationSeconds Int       @default(0)
  connected       Boolean   @default(false)
  outcomeId       String?
  outcomeLabel    String?
  notes           String?
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  createdAt       DateTime  @default(now())

  @@index([employeeId])
  @@index([leadId])
  @@index([companyId])
  @@index([companyId, startedAt])
  @@index([phoneNumber])
  @@index([startedAt])
  @@index([employeeId, startedAt])
  @@index([employeeId, connected])
  @@index([employeeId, leadId])
  @@index([employeeId, leadId, connected])
  @@index([leadId, employeeId])
  @@index([leadId, connected])
  @@index([leadId, connected, startedAt])
  @@index([connected, startedAt])
  @@index([employeeId, connected, startedAt])
  @@index([phoneNumber, connected])
  @@map("call_logs")
}

model EmployeeDevice {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  deviceId    String
  deviceName  String?
  ipAddress   String?
  userAgent   String?
  verifiedAt  DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@unique([employeeId, deviceId])
  @@index([employeeId])
  @@index([deviceId])
  @@map("employee_devices")
}

model ConsumedNonce {
  id        String   @id @default(cuid())
  nonce     String   @unique
  purpose   String   @default("onboarding")
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([nonce])
  @@index([expiresAt])
  @@map("consumed_nonces")
}

model CompanyApiKey {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  keyPrefix   String
  keyHash     String    @unique
  name        String?
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId])
  @@index([keyHash])
  @@index([revokedAt])
  @@map("company_api_keys")
}
